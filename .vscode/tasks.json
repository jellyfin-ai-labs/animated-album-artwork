{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-and-copy",
            "dependsOrder": "sequence",
            "dependsOn": ["build", "make-plugin-dir", "copy-dll"]
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/${config:pluginName}/${config:pluginName}.csproj",
                "--configuration=Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "make-plugin-dir",
            "type": "process",
            "command": "mkdir",
            "args": ["-p", "${config:jellyfinDataDir}/plugins/${config:pluginInstallDir}"],
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-Command", "New-Item -ItemType Directory -Force -Path '${config:jellyfinDataDir}/plugins/${config:pluginInstallDir}'"]
            }
        },
        {
            "label": "copy-dll",
            "type": "process",
            "command": "cp",
            "args": [
                "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.dll",
                "${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.pdb",
                "${config:jellyfinDataDir}/plugins/${config:pluginInstallDir}/"
            ],
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-Command", "Copy-Item -LiteralPath '${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.dll','${workspaceFolder}/${config:pluginName}/bin/Debug/net10.0/publish/${config:pluginName}.pdb' -Destination '${config:jellyfinDataDir}/plugins/${config:pluginInstallDir}/'"]
            }
        }
    ]
}
