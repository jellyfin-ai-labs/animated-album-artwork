{
    // Launch requires a matching, prebuilt Jellyfin server and web checkout.
    "jellyfinDir": "${workspaceFolder}/../jellyfin/Jellyfin.Server",
    "jellyfinWebDir": "${workspaceFolder}/../jellyfin-web",
    // Set this to the native server's data directory when using Launch.
    // The default stages the plugin in the local Docker development server.
    "jellyfinDataDir": "${workspaceFolder}/dev/data/config",
    "pluginName": "Jellyfin.Plugin.AnimatedAlbumArt",
    "pluginInstallDir": "AnimatedAlbumArt_0.1.0.0"
}
